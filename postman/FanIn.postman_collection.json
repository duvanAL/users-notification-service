{
  "info": {
    "name": "Electiva II - Fan In Kafka (usuarios + cuentas + notificaciones)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Ejecutar después de configurar los despliegues y activar los eventos de dominio. Completar las URLs Azure y las credenciales ADMIN en variables locales."
  },
  "variable": [
    {
      "key": "usersBaseUrl",
      "value": "https://users-management-api-a4yf.onrender.com"
    },
    {
      "key": "accountsBaseUrl",
      "value": "http://localhost:18081"
    },
    {
      "key": "notificationsBaseUrl",
      "value": "http://localhost:18082"
    },
    {
      "key": "adminEmail",
      "value": ""
    },
    {
      "key": "adminPassword",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "accountId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "00 - Salud de usuarios",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Respuesta correcta',()=>pm.expect(pm.response.code).to.be.below(300));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "auth": {
          "type": "noauth"
        },
        "url": "{{usersBaseUrl}}/health"
      }
    },
    {
      "name": "01 - Salud de cuentas",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Respuesta correcta',()=>pm.expect(pm.response.code).to.be.below(300));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "auth": {
          "type": "noauth"
        },
        "url": "{{accountsBaseUrl}}/actuator/health"
      }
    },
    {
      "name": "02 - Salud del consumidor",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Respuesta correcta',()=>pm.expect(pm.response.code).to.be.below(300));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "auth": {
          "type": "noauth"
        },
        "url": "{{notificationsBaseUrl}}/health"
      }
    },
    {
      "name": "03 - Login ADMIN existente",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Login OK',()=>pm.response.to.have.status(200));",
              "if(pm.response.code===200) pm.collectionVariables.set('adminToken',pm.response.json().accessToken);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
        },
        "url": "{{usersBaseUrl}}/api/auth/login"
      }
    },
    {
      "name": "04 - Crear usuario (primer productor)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const id=pm.variables.replaceIn('{{$guid}}');",
              "pm.collectionVariables.set('userId',id);",
              "pm.collectionVariables.set('demoEmail','fanin-'+id+'@yopmail.com');",
              "pm.collectionVariables.set('demoPassword','Demo-'+pm.variables.replaceIn('{{$guid}}')+'!');",
              "console.log('Buzón de prueba:',pm.collectionVariables.get('demoEmail'));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Usuario creado',()=>pm.response.to.have.status(201));",
              "if(pm.response.code===201) pm.collectionVariables.set('userId',pm.response.json().id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": \"{{userId}}\",\n  \"name\": \"Demo Fan In\",\n  \"email\": \"{{demoEmail}}\",\n  \"password\": \"{{demoPassword}}\",\n  \"role\": \"MEMBER\"\n}"
        },
        "url": "{{usersBaseUrl}}/api/users"
      }
    },
    {
      "name": "05 - Crear cuenta SAVINGS (segundo productor)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Cuenta creada',()=>pm.response.to.have.status(201));",
              "if(pm.response.code===201) pm.collectionVariables.set('accountId',pm.response.json().id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"accountType\": \"SAVINGS\"\n}"
        },
        "url": "{{accountsBaseUrl}}/api/accounts"
      }
    },
    {
      "name": "06 - Consultar cuenta",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Respuesta correcta',()=>pm.expect(pm.response.code).to.be.below(300));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        },
        "url": "{{accountsBaseUrl}}/api/accounts/{{accountId}}"
      }
    },
    {
      "name": "07 - Listar cuentas del usuario",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Respuesta correcta',()=>pm.expect(pm.response.code).to.be.below(300));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        },
        "url": "{{accountsBaseUrl}}/api/accounts?userId={{userId}}"
      }
    }
  ]
}
