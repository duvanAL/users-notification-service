{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DomainEvent v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "eventId",
    "eventName",
    "occurredOn",
    "payload"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "eventName": {
      "enum": [
        "user.created",
        "user.updated",
        "account.created"
      ]
    },
    "occurredOn": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object",
      "required": [
        "userId",
        "name",
        "email"
      ],
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "eventName": {
            "const": "account.created"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "required": [
              "accountId",
              "accountType"
            ],
            "properties": {
              "accountId": {
                "type": "string",
                "format": "uuid"
              },
              "accountType": {
                "enum": [
                  "SAVINGS",
                  "CHECKING"
                ]
              }
            }
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
